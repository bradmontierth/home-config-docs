          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT UNIX_TIMESTAMP(Created) * 1000 DIV GREATEST($__interval_ms, 60000) * GREATEST($__interval_ms, 60000) AS time,\n  AVG(CASE WHEN StatNM = 'Mem Used Kb' THEN CAST(StatNBR AS DECIMAL(20,2)) END) * 1024 AS `Used`,\n  (AVG(CASE WHEN StatNM = 'Mem Total Kb' THEN CAST(StatNBR AS DECIMAL(20,2)) END) - AVG(CASE WHEN StatNM = 'Mem Used Kb' THEN CAST(StatNBR AS DECIMAL(20,2)) END)) * 1024 AS `Available`\nFROM DeviceMonitoring\nWHERE $__timeFilter(Created) AND DeviceNM = 'Master Closet Pi' AND StatNM IN ('Mem Used Kb', 'Mem Total Kb')\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Memory History",
