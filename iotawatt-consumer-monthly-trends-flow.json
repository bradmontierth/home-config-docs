      "id": "6b80268925dbb07a",
      "type": "function",
      "z": "7b4ea8c23b72358e",
      "name": "Build the query",
      "func": "var years = msg.payload;\n\nlet sql = `\nDROP TABLE IF EXISTS hubitat_logging.SprinklerMonthlyTracking;\nCREATE TABLE hubitat_logging.SprinklerMonthlyTracking AS\nWITH base AS (\n    SELECT DISTINCT MonthBeginDate, MonthNBR\n    FROM dimDate\n    WHERE YearNBR = YEAR(NOW()) - 1\n), \nsolar_usage AS (\n    SELECT MONTH(DateDTS) AS month,\n           YEAR(DateDTS) AS year,\n           SUM(RunTimeSeconds)/60 AS Gallons\n    FROM Rachio\n    GROUP BY MONTH(DateDTS), YEAR(DateDTS)\n)\nSELECT base.MonthBeginDate`;\n\nyears.forEach(row => {\n    sql += `,\n    MAX(CASE WHEN solar_usage.year = ${row.YearNBR} THEN solar_usage.Gallons ELSE NULL END) AS '${row.YearNBR}'`;\n});\n\nsql += `\nFROM base\nLEFT JOIN solar_usage ON base.MonthNBR = solar_usage.month\nGROUP BY base.MonthBeginDate\nORDER BY base.MonthBeginDate;`;\n\nmsg.topic = sql;\nreturn msg;\n",
