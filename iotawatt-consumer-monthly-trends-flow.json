    {
      "id": "766481eca32d3b60",
      "type": "function",
      "z": "7b4ea8c23b72358e",
      "name": "Build the query",
      "func": "var years = msg.payload;\n\nlet sql = `\nDROP TABLE IF EXISTS hubitat_logging.WaterMonthlyTrackingNew;\nCREATE TABLE hubitat_logging.WaterMonthlyTrackingNew AS\nWITH base AS (\n    SELECT DISTINCT MonthBeginDate, MonthNBR\n    FROM dimDate\n    WHERE YearNBR = YEAR(NOW()) - 1\n), \nwater_usage AS (\n    SELECT MONTH(Time) AS month,\n           YEAR(Time) AS year,\n           SUM(value) AS Gallons\n    FROM flume\n    GROUP BY MONTH(Time), YEAR(Time)\n)\nSELECT base.MonthBeginDate`;\n\nyears.forEach(row => {\n    sql += `,\n    MAX(CASE WHEN water_usage.year = ${row.YearNBR} THEN water_usage.Gallons ELSE NULL END) AS '${row.YearNBR}'`;\n});\n\nsql += `\nFROM base\nLEFT JOIN water_usage ON base.MonthNBR = water_usage.month\nGROUP BY base.MonthBeginDate\nORDER BY base.MonthBeginDate;`;\n\nmsg.topic = sql;\nreturn msg;\n",
      "outputs": 1,
      "timeout": 0,
      "noerr": 0,
      "initialize": "",
      "finalize": "",
