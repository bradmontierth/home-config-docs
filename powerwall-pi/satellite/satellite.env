# Family-room mic-only satellite (pw_pi / tesla-pw-listener, 192.168.40.244).
# Playback relays to the kitchen box VIA the orchestrator proxy (this VLAN
# cannot reach 192.168.10.251 directly). HOP_MS=320 chosen from on-device
# benchmark 2026-07-23: dual-model predict ~130ms -> ~40% duty, Pi idles 45C.
MODEL_PATHS=/home/pi/wake-bench/okay_computer.onnx,/home/pi/wake-bench/okay_google.onnx
HOP_MS=320
ORT_THREADS=2
MIC_DEVICE=respeaker_ch0
SILERO_THRESHOLD=0.4
MODE=active
SATELLITE_ID=familyroom
ORCH_BASE=http://192.168.10.217:8785
PLAYBACK_RELAY_URL=http://192.168.10.217:8785/satellite
STOP_THRESHOLD=2.0
