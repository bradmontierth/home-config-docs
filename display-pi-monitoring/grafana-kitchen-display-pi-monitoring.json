          "rawSql": "SELECT UNIX_TIMESTAMP(Created) * 1000 DIV GREATEST($__interval_ms, 60000) * GREATEST($__interval_ms, 60000) AS time,\n  AVG(CASE WHEN StatNM = 'Load1' THEN CAST(StatNBR AS DECIMAL(18,2)) END) AS `1 minute`,\n  AVG(CASE WHEN StatNM = 'Load5' THEN CAST(StatNBR AS DECIMAL(18,2)) END) AS `5 minute`,\n  AVG(CASE WHEN StatNM = 'Load15' THEN CAST(StatNBR AS DECIMAL(18,2)) END) AS `15 minute`\nFROM DeviceMonitoring\nWHERE $__timeFilter(Created) AND DeviceNM = 'Kitchen Display Pi' AND StatNM IN ('Load1', 'Load5', 'Load15')\nGROUP BY 1\nORDER BY 1;",
