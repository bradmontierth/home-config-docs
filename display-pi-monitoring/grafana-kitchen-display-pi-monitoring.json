          "rawSql": "SELECT UNIX_TIMESTAMP(Created) * 1000 DIV GREATEST($__interval_ms, 60000) * GREATEST($__interval_ms, 60000) AS time,\n  AVG(CASE WHEN StatNM = 'Cpu Pct' THEN CAST(StatNBR AS DECIMAL(18,2)) END) AS `CPU`,\n  AVG(CASE WHEN StatNM = 'Mem Pct' THEN CAST(StatNBR AS DECIMAL(18,2)) END) AS `Memory`,\n  AVG(CASE WHEN StatNM = 'Disk Pct Root' THEN CAST(StatNBR AS DECIMAL(18,2)) END) AS `Root Disk`\nFROM DeviceMonitoring\nWHERE $__timeFilter(Created) AND DeviceNM = 'Kitchen Display Pi' AND StatNM IN ('Cpu Pct', 'Mem Pct', 'Disk Pct Root')\nGROUP BY 1\nORDER BY 1;",
