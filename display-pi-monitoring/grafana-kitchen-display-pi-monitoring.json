          "rawQuery": true,
          "rawSql": "SELECT UNIX_TIMESTAMP(Created) * 1000 DIV GREATEST($__interval_ms, 60000) * GREATEST($__interval_ms, 60000) AS time,\n  AVG(CASE WHEN StatNM = 'Disk Used Root Kb' THEN CAST(StatNBR AS DECIMAL(20,2)) END) * 1024 AS `Used`,\n  AVG(CASE WHEN StatNM = 'Disk Avail Root Kb' THEN CAST(StatNBR AS DECIMAL(20,2)) END) * 1024 AS `Available`\nFROM DeviceMonitoring\nWHERE $__timeFilter(Created) AND DeviceNM = 'Kitchen Display Pi' AND StatNM IN ('Disk Used Root Kb', 'Disk Avail Root Kb')\nGROUP BY 1\nORDER BY 1;",
