            "type": "function",
            "name": "ON->active / OFF->shadow",
            "func": "const on = String(msg.payload).toUpperCase() === 'ON';\nmsg.payload = { mode: on ? 'active' : 'shadow' };\nmsg.headers = { 'Content-Type': 'application/json' };\nreturn msg;\n",
            "outputs": 1,
