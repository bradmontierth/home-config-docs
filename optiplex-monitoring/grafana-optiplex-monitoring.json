      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "eebnvy9j8hmgwb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT UNIX_TIMESTAMP(r.Created) * 1000 AS time, CONCAT(CAST(r.StatNBR AS UNSIGNED), ' / ', CAST(t.StatNBR AS UNSIGNED)) AS `Recording` FROM DeviceMonitoring r JOIN DeviceMonitoring t ON t.DeviceNM = r.DeviceNM AND t.StatNM = 'Cams Total' AND t.Created = r.Created WHERE $__timeFilter(r.Created) AND r.DeviceNM = 'Optiplex' AND r.StatNM = 'Cams Recording' ORDER BY r.Created DESC LIMIT 1;"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Recording$/",
          "values": false
        },
