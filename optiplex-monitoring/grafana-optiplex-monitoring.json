          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT UNIX_TIMESTAMP(Created) * 1000 DIV GREATEST($__interval_ms, 60000) * GREATEST($__interval_ms, 60000) AS time, AVG(CAST(StatNBR AS DECIMAL(18,2)) * 9 / 5 + 32) AS `CPU package` FROM DeviceMonitoring WHERE $__timeFilter(Created) AND DeviceNM = 'Optiplex' AND StatNM = 'Temp C' GROUP BY 1 ORDER BY 1;"
