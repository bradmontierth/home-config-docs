    {
      "id": 6,
      "type": "stat",
      "title": "Cameras recording",
      "datasource": {
        "type": "mysql",
        "uid": "eebnvy9j8hmgwb"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
