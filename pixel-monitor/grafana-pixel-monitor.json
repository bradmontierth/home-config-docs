    {
      "id": 16,
      "type": "table",
      "title": "Biggest memory users (latest snapshot, MB)",
      "description": "Resident + swapped memory per process (same-named processes merged).",
      "datasource": {
        "type": "mysql",
        "uid": "eebnvy9j8hmgwb"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "eebnvy9j8hmgwb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT proc AS `Process`, ROUND((rss_kb+swap_kb)/1024) AS `Total MB`, ROUND(rss_kb/1024) AS `In RAM MB`, ROUND(swap_kb/1024) AS `In swap MB` FROM pixel_proc_mem WHERE device = '$device' AND ts = (SELECT MAX(ts) FROM pixel_proc_mem WHERE device = '$device') ORDER BY 2 DESC LIMIT 15"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Memory growth over the selected range (MB)",
      "description": "A process that keeps growing between restarts is the leak suspect. Killed/restarted processes reset.",
      "datasource": {
        "type": "mysql",
        "uid": "eebnvy9j8hmgwb"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "eebnvy9j8hmgwb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT proc AS `Process`, ROUND(MAX(CASE WHEN rl=1 THEN tot END)/1024) AS `Now`, ROUND(MAX(CASE WHEN rf=1 THEN tot END)/1024) AS `At start`, ROUND(MAX(tot)/1024) AS `Peak`, ROUND((MAX(CASE WHEN rl=1 THEN tot END)-MAX(CASE WHEN rf=1 THEN tot END))/1024) AS `Change` FROM (SELECT proc, CAST(rss_kb AS SIGNED)+CAST(swap_kb AS SIGNED) AS tot, ROW_NUMBER() OVER (PARTITION BY proc ORDER BY ts DESC) rl, ROW_NUMBER() OVER (PARTITION BY proc ORDER BY ts) rf FROM pixel_proc_mem WHERE device = '$device' AND $__timeFilter(ts)) x GROUP BY proc ORDER BY `Change` DESC LIMIT 15"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
