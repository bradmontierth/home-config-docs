    {
      "id": 12,
      "type": "timeseries",
      "title": "Low-memory kills (per bucket)",
      "description": "Background apps killed by lmkd. Bursts mean memory ran out; killed apps cold-start next time you open them.",
      "datasource": {
        "type": "mysql",
        "uid": "eebnvy9j8hmgwb"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "eebnvy9j8hmgwb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT UNIX_TIMESTAMP(ts) DIV ($__interval_ms DIV 1000) * ($__interval_ms DIV 1000) AS time, COUNT(*) AS `Apps killed` FROM pixel_events WHERE device = '$device' AND kind='lmk_kill' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "pointSize": 4,
            "showPoints": "always",
            "spanNulls": 180000,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#d95926"
