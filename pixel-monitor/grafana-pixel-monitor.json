{
  "uid": "pixel-monitor",
  "title": "Pixel Phone Performance",
  "tags": [
    "phone",
    "pixel-monitor"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "pixel-monitor: adb stats from the phone every minute (home_config/pixel-monitor).",
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Phone",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "eebnvy9j8hmgwb"
        },
        "query": "SELECT DISTINCT device FROM pixel_metrics",
        "definition": "SELECT DISTINCT device FROM pixel_metrics",
        "refresh": 1,
        "current": {
          "text": "Brad Pixel 8 Pro",
          "value": "Brad Pixel 8 Pro"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Lag marks",
        "enable": true,
        "iconColor": "#ec835a",
        "datasource": {
          "type": "mysql",
          "uid": "eebnvy9j8hmgwb"
        },
        "target": {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "eebnvy9j8hmgwb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT UNIX_TIMESTAMP(ts)*1000 AS time, CONCAT('Lag mark', IFNULL(CONCAT(' \u2014 ', app), ''), IFNULL(CONCAT(': ', detail), '')) AS text FROM pixel_events WHERE device = '$device' AND kind='lag_mark' AND $__timeFilter(ts)"
        }
      },
      {
        "name": "Reboots",
        "enable": true,
        "iconColor": "#3987e5",
        "datasource": {
          "type": "mysql",
          "uid": "eebnvy9j8hmgwb"
        },
        "target": {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "eebnvy9j8hmgwb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT UNIX_TIMESTAMP(ts)*1000 AS time, CONCAT('Reboot (', detail, ')') AS text FROM pixel_events WHERE device = '$device' AND kind='reboot' AND $__timeFilter(ts)"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Memory available",
      "description": "MemAvailable right now. Under ~1 GB the phone is reclaiming memory constantly.",
      "datasource": {
        "type": "mysql",
        "uid": "eebnvy9j8hmgwb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "eebnvy9j8hmgwb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT mem_avail_kb*1024 AS v FROM pixel_metrics WHERE device = '$device' ORDER BY ts DESC LIMIT 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d03b3b",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1000000000.0
              },
              {
                "color": "#0ca30c",
                "value": 2000000000.0
              }
            ]
          }
        },
        "overrides": []
      }
    },
