    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory (GB)",
      "description": "RAM available falling while swap used climbs to its ~5.65 GB ceiling = memory exhausted.",
      "datasource": {
        "type": "mysql",
        "uid": "eebnvy9j8hmgwb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "eebnvy9j8hmgwb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT UNIX_TIMESTAMP(ts) DIV ($__interval_ms DIV 1000) * ($__interval_ms DIV 1000) AS time, AVG(mem_avail_kb)/1048576 AS `RAM available`, AVG(swap_total_kb-swap_free_kb)/1048576 AS `Swap used` FROM pixel_metrics WHERE device = '$device' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": 180000,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RAM available"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Swap used"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Swap thrash (per second)",
      "description": "How often apps wait for memory to be read back from swap or storage. Sustained spikes are what lag feels like.",
      "datasource": {
        "type": "mysql",
        "uid": "eebnvy9j8hmgwb"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "eebnvy9j8hmgwb"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT UNIX_TIMESTAMP(ts) DIV ($__interval_ms DIV 1000) * ($__interval_ms DIV 1000) AS time, AVG(swapin_ps) AS `Pages swapped in`, AVG(majfault_ps) AS `Major page faults` FROM pixel_metrics WHERE device = '$device' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": 180000,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "gradientMode": "none"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pages swapped in"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Major page faults"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
